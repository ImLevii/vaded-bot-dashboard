# Discord bot token, referenced from app.yml via ${DISCORD_TOKEN}
DISCORD_TOKEN=

# Shared secret for the web API (dashboard's Lavalink admin panel + music
# proxy authenticate with this), referenced from app.yml via ${VG_MUSIC_BOT_TOKEN}
VG_MUSIC_BOT_TOKEN=

# Postgres connection string for the dashboard's shared database — used to
# keep track history / 24-7 session snapshots / saved queues / autoplay
# counters visible on the dashboard (see src/db/postgres.ts). Optional: if
# unset, these writes are silently skipped.
DATABASE_URL=

# MongoDB credentials used by docker-compose.yml (vg-music-bot/docker-compose.yml,
# standalone local dev only — not used when deployed alongside the dashboard,
# which uses the default JSON-file DB driver instead)
MONGO_USER=byteblaze
MONGO_PASSWORD=changeme
